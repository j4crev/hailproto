; Hail v0 structural schemas and draft QR-connection consent shapes
;
; Status: Draft; current creation profiles are listed in README.md.
; Historical alternatives retained below are not compatibility requirements.
; All three current body profiles (spt-1, spt-2, spt-3) are mandatory provider
; capabilities; see bodies.md for support requirements and transport size limits.
;
; This file defines the structural Hail Data Model shapes used by the v0
; specifications. The Markdown object specifications remain authoritative for
; semantic constraints, conditional fields, identifier grammars, ordering,
; normalization, and cross-field validation.

start =
  hail-address-binding /
  hail-sender-profile /
  hail-grant /
  hail-connection-invitation /
  hail-connection-confirmation /
  hail-connection-control /
  hail-conversation /
  hail-conversation-revival /
  hail-envelope /
  hail-delivery-status /
  hail-body-spt-1 /
  hail-body-spt-2 /
  hail-body-spt-3

hail-int = -9007199254740991..9007199254740991
hail-uint = 0..9007199254740991
hail-positive = 1..9007199254740991
timestamp = hail-uint
did = tstr
did-url = tstr
uuidv7 = tstr
category-id = tstr
sha256 = bstr .size 32
bearer-token = bstr .size 32

digest = {
  "algorithm": "sha-256",
  "value": sha256
}

; Fixed-roster conversation control objects; these are not delivery grants.
hail-conversation = {
  "type": "hail.conversation",
  "version": 1,
  "conversation_id": uuidv7,
  "from": did,
  "membership_revision": 1,
  "participants": [3*101 did],
  "created_at": timestamp,
  "admission_until": timestamp
}

hail-conversation-revival = {
  "type": "hail.conversation-revival",
  "version": 1,
  "conversation_id": uuidv7,
  "descriptor_hash": digest,
  "from": did,
  "to": did,
  "request_id": uuidv7,
  "issued_at": timestamp,
  "expires_at": timestamp
}

hail-address-binding = {
  "version": 2,
  "type": "hail.address-binding",
  "address": tstr,
  "did": did,
  "issued_at": timestamp,
  "key_id": did-url
}

hail-sender-profile = hail-sender-profile-v1 / hail-sender-profile-v2

hail-sender-profile-v1 = {
  "type": "hail.sender-profile",
  "version": 1,
  "did": did,
  "revision": hail-positive,
  "display_name": tstr,
  ? "description": tstr,
  "categories": [0*100 sender-category],
  "updated_at": timestamp,
  "key_id": did-url
}

hail-sender-profile-v2 = {
  "type": "hail.sender-profile",
  "version": 2,
  "did": did,
  "revision": hail-positive,
  "display_name": tstr,
  ? "description": tstr,
  "categories": [0*100 sender-category],
  ? "assets": asset-manifest-v1,
  "updated_at": timestamp,
  "key_id": did-url
}

sender-category = {
  "id": category-id,
  "label": tstr,
  ? "description": tstr
}

hail-grant = {
  "type": "hail.grant",
  "version": 1,
  "grant_id": uuidv7,
  "revision": hail-positive,
  "previous": null / sha256,
  "grantor": did,
  "grantee": did,
  "scope": [grant-scope],
  "status": "active" / "revoked",
  "issued_at": timestamp,
  "updated_at": timestamp,
  "expires_at": null / timestamp,
  "consent_context": consent-context,
  "key_id": did-url
}

grant-scope = category-scope

category-scope = {
  "type": "categories",
  "values": [1* category-id]
}

consent-context = {
  "grantee_address": tstr,
  "address_binding_hash": digest,
  "sender_profile_hash": digest
}

; Connection consent objects; federation uses connection-control and Envelope v2/v3.
; Historical connection-grant is not the current admission mechanism.
hail-connection-invitation = {
  "type": "hail.connection-invitation",
  "version": 1,
  "invitation_id": uuidv7,
  "from": did,
  "token_hash": digest,
  "issued_at": timestamp,
  "expires_at": null / timestamp,
  "key_id": did-url
}

hail-connection-confirmation = {
  "type": "hail.connection-confirmation",
  "version": 1,
  "confirmation_id": uuidv7,
  "from": did,
  "to": did,
  "invitation_id": uuidv7,
  "invitation_hash": digest,
  "issued_at": timestamp,
  "expires_at": timestamp,
  "key_id": did-url
}

hail-envelope = hail-envelope-v1 / hail-envelope-v2 / hail-envelope-v3 / hail-envelope-v4

hail-envelope-v4 = {
  "type": "hail.envelope",
  "version": 4,
  "message_id": uuidv7,
  "from": did,
  "to": did,
  "authorization": {"type": "conversation", "creator": did, "conversation_id": uuidv7, "membership_revision": 1, "descriptor_hash": digest},
  "conversation_message_id": uuidv7,
  ? "conversation_introduction": {"descriptor": bstr, "connection_id": uuidv7, "epoch": hail-positive},
  ? "in_reply_to": {"sender": did, "message_id": uuidv7},
  ? "message_type": message-type,
  "created_at": timestamp,
  "expires_at": timestamp,
  "body": body-descriptor,
  "reply": {"allowed": false}
}

hail-envelope-v1 = {
  "type": "hail.envelope",
  "version": 1,
  "message_id": uuidv7,
  "from": did,
  "to": did,
  "authorization": envelope-authorization,
  ? "category": category-id,
  ? "message_type": message-type,
  "created_at": timestamp,
  "expires_at": timestamp,
  "body": body-descriptor,
  "reply": reply-permission
}

hail-envelope-v2 = {
  "type": "hail.envelope",
  "version": 2,
  "message_id": uuidv7,
  "from": did,
  "to": did,
  "authorization": {"type": "connection", "connection_id": uuidv7, "epoch": hail-positive},
  ? "message_type": message-type,
  "created_at": timestamp,
  "expires_at": timestamp,
  "body": body-descriptor,
  "reply": {"allowed": false}
}

; Version 3 is a reply with a signed parent, independent of delivery authority.
hail-envelope-v3 = {
  "type": "hail.envelope",
  "version": 3,
  "message_id": uuidv7,
  "from": did,
  "to": did,
  "in_reply_to": {"sender": did, "message_id": uuidv7},
  "authorization": {"type": "reply", "reply_to": uuidv7} /
    {"type": "connection", "connection_id": uuidv7, "epoch": hail-positive},
  ? "message_type": message-type,
  "created_at": timestamp,
  "expires_at": timestamp,
  "body": body-descriptor,
  "reply": reply-permission
}

hail-connection-control = {
  "type": "hail.connection-control",
  "version": 1,
  "operation": "probe" / "offer" / "connect" / "disconnect" / "snapshot" / "admission" / "ack",
  "from": did,
  "to": did,
  "request_id": uuidv7,
  "connection_id": null / uuidv7,
  "epoch": hail-uint,
  "state": "empty" / "active" / "disconnected",
  "proof_hash": digest,
  "issued_at": timestamp,
  "expires_at": null / timestamp,
  "key_id": did-url
}

hail-connection-grant = {
  "type": "hail.connection-grant",
  "version": 1,
  "grant_id": uuidv7,
  "connection_id": uuidv7,
  "revision": hail-positive,
  "previous": null / sha256,
  "grantor": did,
  "grantee": did,
  "status": "active" / "revoked",
  "issued_at": timestamp,
  "updated_at": timestamp,
  "expires_at": null / timestamp,
  "consent_context": {
    "grantee_address": tstr,
    "address_binding_hash": digest,
    "invitation_hash": digest,
    "confirmation_hash": digest
  },
  "key_id": did-url
}

envelope-authorization = grant-authorization / reply-authorization

grant-authorization = {
  "type": "grant",
  "grant_id": uuidv7
}

reply-authorization = {
  "type": "reply",
  "reply_to": uuidv7
}

message-type =
  "personal" /
  "newsletter" /
  "promotion" /
  "receipt" /
  "invoice" /
  "ticket" /
  "boarding-pass" /
  "account-alert" /
  "security-alert" /
  "package-update" /
  "calendar-event"

; Semantic constraints: available_until and access.expires_at are at most
; envelope.created_at + 2678400 (31 days); see envelopes.md for lower bounds.
body-descriptor = {
  "digest": digest,
  "size": 1..1048576,
  "media_type": "application/hail-body+cbor",
  "profile": "spt-1" / "spt-2" / "spt-3",
  "available_until": timestamp,
  "access": bearer-access
}

bearer-access = {
  "type": "bearer",
  "token": bearer-token,
  "expires_at": timestamp
}

reply-permission = replies-prohibited / replies-permitted

replies-prohibited = {
  "allowed": false
}

replies-permitted = {
  "allowed": true,
  "until": timestamp
}

delivery-status-common = (
  "type": "hail.delivery-status",
  "version": 1,
  "message_id": uuidv7,
  "envelope_digest": digest,
  "from": did,
  "to": did,
  "occurred_at": timestamp
)

hail-delivery-status =
  delivery-accepted /
  delivery-on-hold /
  delivery-delivered /
  delivery-failed /
  delivery-cancelled

delivery-accepted = {
  delivery-status-common,
  "revision": 1,
  "state": "accepted"
}

delivery-on-hold = {
  delivery-status-common,
  "revision": 2..9007199254740991,
  "state": "on-hold",
  "reason": hold-reason,
  "retry_at": timestamp
}

delivery-delivered = {
  delivery-status-common,
  "revision": 2..9007199254740991,
  "state": "delivered"
}

delivery-failed = {
  delivery-status-common,
  "revision": 2..9007199254740991,
  "state": "failed",
  "reason": failure-reason
}

delivery-cancelled = {
  delivery-status-common,
  "revision": 2..9007199254740991,
  "state": "cancelled",
  "reason": cancellation-reason
}

hold-reason =
  "sender-unreachable" /
  "body-temporarily-unavailable" /
  "body-transfer-interrupted" /
  "sender-rate-limited" /
  "receiver-resource-constrained"

failure-reason =
  "body-authorization-failed" /
  "body-integrity-failed" /
  "body-invalid" /
  "body-unsupported" /
  "delivery-expired" /
  "receiver-policy-rejected"

cancellation-reason =
  "recipient-cancelled" /
  "receiver-administrative-cancellation"

delivery-state = "accepted" / "on-hold" / "delivered" / "failed" / "cancelled"

; spt-1 remains the initial plain-text Portable Text-shaped profile.
hail-body-spt-1 = {
  "version": 1,
  "profile": "spt-1",
  "blocks": [* spt-1-text-block],
  ? "attachments": [1*20 hail-attachment]
}

spt-1-text-block = {
  "_type": "block",
  "style": "normal",
  "children": [1* spt-1-span],
  "markDefs": []
}

spt-1-span = {
  "_type": "span",
  "text": tstr,
  "marks": []
}

; spt-2 adds a closed set of styles, lists, decorators and HTTPS links.
hail-body-spt-2 = {
  "version": 1,
  "profile": "spt-2",
  "blocks": [* spt-2-text-block],
  ? "attachments": [1*20 hail-attachment]
}

spt-2-text-block = {
  "_type": "block",
  "style": "normal" / "h1" / "h2" / "h3" / "blockquote" / "caption" / "cta",
  "children": [1* spt-2-span],
  "markDefs": [* spt-link],
  ? "listItem": "bullet" / "number",
  ? "level": 1..3,
  ? "alignment": "left" / "center" / "right"
}

spt-2-span = {
  "_type": "span",
  "text": tstr,
  "marks": [* tstr]
}

spt-link = {
  "_key": tstr,
  "_type": "spt.link",
  "href": tstr,
  ? "title": tstr
}

; spt-3 interleaves bounded, digest-bound PNG images and rich text.
hail-body-spt-3 = {
  "version": 1,
  "profile": "spt-3",
  "assets": asset-manifest-v1,
  "blocks": [1* (spt-image-block / spt-2-text-block)],
  ? "attachments": [1*20 hail-attachment]
}

spt-image-block = {
  "_type": "spt.image",
  "asset": tstr,
  "alt": tstr,
  ? "caption": tstr
}

; Reusable bundled-image manifest for future body and profile versions.
asset-manifest-v1 = {
  "version": 1,
  "assets": [1*8 bundled-image-asset-v1]
}

bundled-image-asset-v1 = {
  "id": tstr,
  "role": "avatar" / "header" / "image",
  "media_type": "image/png",
  "loading": "bundled",
  "size": 1..196608,
  "digest": digest,
  "width": 1..2400,
  "height": 1..2400,
  "data": bstr
}

; Detached files: the sum of sizes is at most 26,214,400 bytes per body.
hail-attachment = {
  "filename": tstr,
  "media_type": "application/pdf" / "text/plain" / "image/png" / "image/jpeg" / "image/webp",
  "size": 1..26214400,
  "digest": digest
}
