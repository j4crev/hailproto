[Unit]
Description=Haili Cloudflare Tunnel
Wants=network-online.target
After=network-online.target docker.service

[Service]
DynamicUser=yes
LoadCredential=tunnel-token:/etc/cloudflared/haili-provider.token
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file %d/tunnel-token
Restart=always
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
