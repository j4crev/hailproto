PROVIDER_DOMAIN=haili.app
PROVIDER_ID=haili
PLC_PROVIDER_OPERATORS=["haili-provider"]
PLC_READER_DIAGNOSTIC_DID=
DB_PASSWORD=replace-with-generated-base64url-value
KEY_ENCRYPTION_KEY=replace-with-43-character-base64url-value
PUBLIC_SELF_SERVICE_ONBOARDING=false
PASSKEY_AUTH=true
# Optional signup email proxy; configure both to enable. Keep token server-only.
SIGNUP_EMAIL_ORIGIN=
SIGNUP_EMAIL_TOKEN=
# Optional automatic alpha monitoring; requires email plus strict public PLC.
SIGNUP_MONITOR_API_ORIGIN=
SIGNUP_MONITOR_TOKEN=
SIGNUP_MONITOR_PUBLIC_KEY=
# Local backend is implemented; leave off until reviewed invited-pilot rollout.
PUBLIC_ALPHA_SIGNUP=false
ALPHA_SIGNUP_INVITE_KEY=
ALPHA_SIGNUP_MONITOR_ORIGIN=
