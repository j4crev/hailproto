{
  "name": "hail-server-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "account:credential-create": "bun src/cli/create-account-credential.ts",
    "account:credential-revoke": "bun src/cli/revoke-account-credential.ts",
    "activate:local": "bun src/cli/activate-local.ts",
    "activate:public": "bun src/cli/activate-public.ts",
    "db:migrate": "bun src/cli/migrate.ts",
    "dev": "bun --watch src/index.ts",
    "onboard": "bun src/cli/onboard.ts",
    "poc:prepare-portable": "bun src/cli/prepare-private-poc.ts",
    "poc:register-portable": "bun src/cli/register-private-poc.ts",
    "poc:submit-cutover": "bun src/cli/submit-private-poc-cutover.ts",
    "poc:publish-address": "bun src/cli/publish-private-poc-address.ts",
    "poc:activate-transfer": "bun src/cli/activate-private-poc-transfer.ts",
    "poc:retire-source": "bun src/cli/retire-private-poc-source.ts",
    "poc:grant-propose": "bun src/cli/propose-private-poc-grant.ts",
    "poc:grant-import": "bun src/cli/import-private-poc-grant.ts",
    "profile:create": "bun src/cli/create-profile.ts",
    "profile:verify": "bun src/cli/verify-profile.ts",
    "grant:create": "bun src/cli/create-grant.ts",
    "grant:revoke": "bun src/cli/revoke-grant.ts",
    "grant:publish": "bun src/cli/publish-grants.ts",
    "body:publish": "bun src/cli/publish-body.ts",
    "body:authorize": "bun src/cli/authorize-body.ts",
    "envelope:create": "bun src/cli/create-envelope.ts",
    "envelope:reply": "bun src/cli/create-reply.ts",
    "envelope:submit": "bun src/cli/submit-envelope.ts",
    "delivery:once": "bun src/cli/work-deliveries.ts",
    "status:publish": "bun src/cli/publish-status.ts",
    "migration:fence": "bun src/cli/fence-migration.ts",
    "migration:prepare-target": "bun src/cli/prepare-migration-target.ts",
    "migration:invite": "bun src/cli/invite-transfer.ts",
    "migration:deliver-invitation": "bun src/cli/deliver-transfer-invitation.ts",
    "migration:publish-final": "bun src/cli/publish-transfer-request.ts",
    "migration:export": "bun src/cli/export-migration.ts",
    "migration:stage": "bun src/cli/stage-migration.ts",
    "server": "bun src/index.ts",
    "test": "vitest run",
    "test:plc-live": "bun --bun vitest run test/public-plc-live.test.ts",
    "test:integration": "bun --bun vitest run test/grant-repository.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@atproto/common": "0.8.1",
    "@atproto/crypto": "0.5.4",
    "@did-plc/lib": "file:../did-method-plc/packages/lib",
    "@hailproto/codec": "file:../hailproto/packages/hail-codec-ts",
    "@ipld/dag-cbor": "9.2.7",
    "hono": "4.13.9",
    "ipaddr.js": "2.2.0",
    "multiformats": "13.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
