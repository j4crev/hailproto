NODE_ENV=development
PORT=3000
PROVIDER_ID=app
PUBLIC_ORIGIN=https://hailproto.app
HAIL_SERVICE_BASE=https://hailproto.app/hail
PLC_DIRECTORY_URL=http://localhost:2582
DATABASE_URL=postgresql://hail_app:replace-me@localhost:5432/hail_app
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
KEY_ENCRYPTION_KEY=replace-with-43-character-base64url-value
# Remains off until all production gates pass; see README for required declarations.
PUBLIC_MANAGED_TRANSFER=false
