{
  "name": "hail-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "preview:design": "bun run build && bun scripts/preview-design.ts",
    "build": "vite build",
    "start": "HOST=127.0.0.1 node build",
    "test": "vitest run",
    "test:browser": "bun scripts/check-browser-signup.ts",
    "test:wizard": "bun run build && bun scripts/check-browser-wizard.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:relationships": "bun run build && bun scripts/check-browser-relationship-removal.ts",
    "test:polish": "bun run build && bun scripts/check-browser-client-polish.ts && bun scripts/check-browser-client-polish.ts --shared",
    "test:cleanup": "bun run build && bun scripts/check-browser-mailbox-cleanup.ts",
    "test:compose": "bun run build && bun scripts/check-browser-compose.ts",
    "test:conversations": "bun run build && bun scripts/check-browser-conversations.ts && bun scripts/check-browser-conversations.ts --shared"
  },
  "dependencies": {
    "@atproto/common": "0.8.1",
    "@atproto/crypto": "0.5.4",
    "@did-plc/lib": "file:../../vendor/did-method-plc/packages/lib",
    "@ipld/dag-cbor": "9.2.7",
    "@racrproto/client-support": "workspace:*",
    "@racrproto/codec": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "multiformats": "13.4.2",
    "qrcode-generator": "^2.0.4",
    "@racrproto/content-builder": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^7.0.0",
    "vitest": "5.0.5"
  }
}
