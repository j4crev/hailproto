{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hail-plc-monitor-alerts",
  "main": "worker.ts",
  "compatibility_date": "2026-10-20",
  "routes": [
    { "pattern": "alerts.plcmonitor.us", "custom_domain": true }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "ALERT_DEDUPLICATOR", "class_name": "AlertDeduplicator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AlertDeduplicator"] }
  ],
  "kv_namespaces": [
    {
      "binding": "HAIL_PRODUCTION_MONITOR",
      "id": "a8af17cce137468e872de646746697ba"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "vars": {
    "ALERT_RECIPIENT": "the@j4w8n.com",
    "ALERT_SENDER": "security@notify.haili.app",
    "SIGNUP_SENDER": "welcome@notify.haili.app",
    "SIGNUP_ORIGIN": "https://haili.app",
    "PROVIDER_HEALTH_URL": "https://haili.app/health/ready"
  }
}
