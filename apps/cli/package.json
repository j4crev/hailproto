{
  "name": "hail-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "hailp": "dist/hailp"
  },
  "scripts": {
    "build": "python3 scripts/build.py",
    "hailp": "./dist/hailp",
    "test": "cargo test --locked",
    "test:workflows": "bun tests/compatibility.ts && bun tests/vault-compatibility.ts && bun tests/transfer-e2e.ts && python3 tests/terminal-input.py target/debug/hailp",
    "smoke": "bun scripts/smoke.ts",
    "verify:install": "python3 scripts/verify-install.py",
    "eval:agents": "bun scripts/agent-eval.ts",
    "smoke:connections": "bun scripts/connection-smoke.ts",
    "eval:connections": "bun scripts/connection-eval.ts"
  },
  "devDependencies": {
    "@hailproto/codec": "workspace:*",
    "@hailproto/client-support": "workspace:*",
    "@atproto/common": "0.8.1",
    "@atproto/crypto": "0.5.4",
    "@did-plc/lib": "file:../../vendor/did-method-plc/packages/lib",
    "@ipld/dag-cbor": "9.2.7",
    "multiformats": "13.4.2"
  }
}
