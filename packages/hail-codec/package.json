{
  "name": "@hailproto/codec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors/v1.json": "./vectors/v1.json"
  },
  "bin": {
    "hail-codec": "./dist/cli.js"
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bench": "bun run bench/codec.bench.ts",
    "bench:sizes": "bun run scripts/report-sizes.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p bench/tsconfig.json",
    "vectors:generate": "bun run scripts/generate-vectors.ts"
  },
  "dependencies": {
    "cborg": "^6.1.2",
    "tldts": "^7.4.12",
    "tr46": "^6.0.0"
  },
  "devDependencies": {
    "@cbortech/cbor": "0.27.1",
    "@types/node": "^26.5.0",
    "@types/tr46": "^5.0.1",
    "tinybench": "6.1.6"
  }
}
